{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  }
}
