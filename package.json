{
  "name": "producers-toolbox",
  "version": "0.0.0",
  "private": true,
  "description": "Stream My Event producer tools in one desktop app",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm --filter @producers-toolbox/desktop start",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:secrets": "node scripts/check-secrets.js",
    "typecheck": "turbo run typecheck",
    "test": "node --test \"scripts/*.test.js\" && turbo run test",
    "test:e2e": "turbo run test:e2e",
    "dist": "pnpm --filter @producers-toolbox/desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
