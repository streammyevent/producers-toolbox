{
  "name": "@producers-toolbox/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Producers Toolbox: the desktop app that hosts the Stream My Event producer tools",
  "author": "Stream My Event",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
