{
  "name": "@producers-toolbox/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Producers Toolbox: the desktop app that hosts the Stream My Event producer tools",
  "author": "Stream My Event",
  "license": "UNLICENSED",
  "main": "out/main/main.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "tsc -p . && node scripts/start.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\"",
    "dist": "tsc -p . && electron-builder --publish never",
    "icon": "node scripts/make-icon.js",
    "dist:dir": "tsc -p . && electron-builder --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "44.9.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "1.64.1"
  }
}
